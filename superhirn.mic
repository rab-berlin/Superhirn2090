; superhirn.mic - Superhirn (Mastermind) fuer Busch Microtronic 2090 mit LED-Matrix (ESP2090 Studio)
; Matrix (Zeile 0 unten, Spalte 0 links), eine Zeile je Versuch, 8 Versuche:
;   Spalten 0-3: die vier Stecker, Farbe 1-6 = rot, orange, gelb, gruen, tuerkis, blau
;   Spalten 4-7: Bewertung von rechts nach links: erst magenta = Farbe am richtigen Platz,
;   dann weiss = Farbe kommt vor, falscher Platz
;   Versuch 1 in Zeile 0, jeder weitere eine Zeile hoeher; er beginnt als Kopie des letzten.
; Display (beim Warten auf eine Taste): Nummer des Versuchs 1-8; am Ende Versuche bis zum Treffer, 0 = nicht geloest
; Start: Matrix wach (LED on; Emulator2090: m), HALT NEXT 00 RUN. Kein Userscript noetig (Farben der Firmware).
;        Die Zeit von RESET bis RUN bestimmt den ersten Code, danach die Wartezeit am Spielende.
; Tasten: 0-3 naechste Farbe fuer Stecker 1-4, 4-7 vorige Farbe fuer Stecker 1-4, F bewerten, C aufgeben
;   (Code in Zeile 7, Display 0); 8-B, D, E nichts.
;   Erster Versuch: rot orange gelb gruen.
; Ende: vier magenta = geloest. Nach dem 8. Fehlversuch rutscht das Brett eine Zeile nach unten (Versuch 1
;   verschwindet) und in Zeile 7 steht der Code. Eine Taste beginnt ein neues Spiel.
; Matrixbefehle ohne Wartezeit dazwischen: jeder Befehl endet mit 0 an den Ausgaengen (DOT R8 bzw. DOT RF),
;   PEGS faengt das REQ nach jedem Befehl noch im selben Fenster; R8 = 0 waehrend PEGS.
; Keine verschachtelten CALLs.
;
; Register: R0-R3 Versuch (Stecker 1-4, Farbe 1-6), R4 = E (ACK 14), R5 = 4 (ACK 4), R6 Matrixzeile,
;   R7 Versuch 1-8 (Display), R8 Taste bzw. 0 fuer PEGS, R9 x + 9 (Zeichenart 1, PEGS zaehlt vorher herunter),
;   RA Farbe, RB Zahl der Pixel;
;   in der Bewertung R8-RB Kopie des Codes, RC schwarz, RD gesamt, dann weiss, RE Hilfe;
;   CMD: RE ACK, RD 1. Nibble, RC 2. Nibble; RF REQ
; M8-MB: der Code (RND, bleibt das ganze Spiel)

F02 ; 00 START:      DISOUT               Anzeige aus: 9,3 ms je Schritt, die Matrix braucht das
1E4 ; 01             MOVI   E,r4          Konstanten fuer PEGS
145 ; 02             MOVI   4,r5
13E ; 03 NEW:        MOVI   3,rE          ACK 3,3: alle Pixel aus, Farben bleiben
13D ; 04             MOVI   3,rD
BBA ; 05             CALL   CMD
F05 ; 06             RND                  Zaehler RD RE RF: Zeit seit RESET bzw. Wartezeit am Spielende
100 ; 07             MOVI   0,r0          Code: Stecker 1-3 = D, E, F modulo 6; Stecker 4 aus den Quotienten:
111 ; 08             MOVI   1,r1          (D / 6 + 2 E / 6 + 3 F / 6) modulo 6; alle 1296 Codes moeglich
0DC ; 09             MOV    rD,rC
BB3 ; 0A             CALL   MOD
0C8 ; 0B             MOV    rC,r8
121 ; 0C             MOVI   2,r1
0EC ; 0D             MOV    rE,rC
BB3 ; 0E             CALL   MOD
0C9 ; 0F             MOV    rC,r9
131 ; 10             MOVI   3,r1
0FC ; 11             MOV    rF,rC
BB3 ; 12             CALL   MOD
0CA ; 13             MOV    rC,rA
00C ; 14             MOV    r0,rC
BB3 ; 15             CALL   MOD
0CB ; 16             MOV    rC,rB
F78 ; 17             MAS    r8            Code nach M8-MB
F79 ; 18             MAS    r9
F7A ; 19             MAS    rA
F7B ; 1A             MAS    rB
110 ; 1B             MOVI   1,r0          erster Versuch: rot orange gelb gruen
121 ; 1C             MOVI   2,r1
132 ; 1D             MOVI   3,r2
143 ; 1E             MOVI   4,r3
117 ; 1F             MOVI   1,r7
106 ; 20             MOVI   0,r6          Zeile 0
108 ; 21 ROW:        MOVI   0,r8          R3-R0 in Zeile R6 zeichnen, von rechts
1C9 ; 22             MOVI   C,r9
11B ; 23             MOVI   1,rB
03A ; 24             MOV    r3,rA
BD1 ; 25             CALL   PEGS
11B ; 26             MOVI   1,rB
02A ; 27             MOV    r2,rA
BD1 ; 28             CALL   PEGS
11B ; 29             MOVI   1,rB
01A ; 2A             MOV    r1,rA
BD1 ; 2B             CALL   PEGS
11B ; 2C             MOVI   1,rB
00A ; 2D             MOV    r0,rA
BD1 ; 2E             CALL   PEGS
077 ; 2F             MOV    r7,r7         R7 = 0: Code aufgedeckt, Spielende
E90 ; 30             BRZ    OVER
F17 ; 31 KEY:        DISP   1,r7          Display: Versuch
FF8 ; 32             KIN    r8
F02 ; 33             DISOUT
9F8 ; 34             CMPI   F,r8          F: bewerten
E56 ; 35             BRZ    EVAL
9C8 ; 36             CMPI   C,r8          C: aufgeben
E88 ; 37             BRZ    GIVE
978 ; 38             CMPI   7,r8          8-B, D, E: nichts
D31 ; 39             BRC    KEY
089 ; 3A             MOV    r8,r9
339 ; 3B             ANDI   3,r9          Stecker 0-3
09B ; 3C             MOV    r9,rB
E46 ; 3D             BRZ    P0
71B ; 3E             SUBI   1,rB
E4A ; 3F             BRZ    P1
71B ; 40             SUBI   1,rB
E4E ; 41             BRZ    P2
03A ; 42 P3:         MOV    r3,rA
BA6 ; 43             CALL   CYC
0A3 ; 44             MOV    rA,r3
C51 ; 45             GOTO   KD
00A ; 46 P0:         MOV    r0,rA
BA6 ; 47             CALL   CYC
0A0 ; 48             MOV    rA,r0
C51 ; 49             GOTO   KD
01A ; 4A P1:         MOV    r1,rA
BA6 ; 4B             CALL   CYC
0A1 ; 4C             MOV    rA,r1
C51 ; 4D             GOTO   KD
02A ; 4E P2:         MOV    r2,rA
BA6 ; 4F             CALL   CYC
0A2 ; 50             MOV    rA,r2
599 ; 51 KD:         ADDI   9,r9          ein Pixel (Stecker, Zeile) in der neuen Farbe
11B ; 52             MOVI   1,rB
108 ; 53             MOVI   0,r8
BD1 ; 54             CALL   PEGS
C31 ; 55             GOTO   KEY
F0E ; 56 EVAL:       EXRM                 Code nach R8-RB (M8-MF bekommen die Hilfsregister) ...
F78 ; 57             MAS    r8            ... und gleich wieder sichern
F79 ; 58             MAS    r9
F7A ; 59             MAS    rA
F7B ; 5A             MAS    rB
10C ; 5B             MOVI   0,rC          schwarz: gleiche Farbe am gleichen Platz
00E ; 5C             MOV    r0,rE
68E ; 5D             SUB    r8,rE
71E ; 5E             SUBI   1,rE          Borgen nur bei 0 ...
FBC ; 5F             ADC    rC            ... dann schwarz + 1
01E ; 60             MOV    r1,rE
69E ; 61             SUB    r9,rE
71E ; 62             SUBI   1,rE
FBC ; 63             ADC    rC
02E ; 64             MOV    r2,rE
6AE ; 65             SUB    rA,rE
71E ; 66             SUBI   1,rE
FBC ; 67             ADC    rC
03E ; 68             MOV    r3,rE
6BE ; 69             SUB    rB,rE
71E ; 6A             SUBI   1,rE
FBC ; 6B             ADC    rC
10D ; 6C             MOVI   0,rD          gesamt: jeder Stecker sucht eine freie gleiche Farbe im Code
00E ; 6D             MOV    r0,rE
B94 ; 6E             CALL   TOT
01E ; 6F             MOV    r1,rE
B94 ; 70             CALL   TOT
02E ; 71             MOV    r2,rE
B94 ; 72             CALL   TOT
03E ; 73             MOV    r3,rE
B94 ; 74             CALL   TOT
6CD ; 75             SUB    rC,rD         weiss = gesamt - schwarz
108 ; 76             MOVI   0,r8
109 ; 77             MOVI   0,r9          Bewertung ab x = 7 nach links (0 = 7 + 9 modulo 16)
18A ; 78             MOVI   8,rA          magenta: schwarz
0CB ; 79             MOV    rC,rB
BD1 ; 7A             CALL   PEGS
19A ; 7B             MOVI   9,rA          weiss
0DB ; 7C             MOV    rD,rB
BD1 ; 7D             CALL   PEGS
94C ; 7E             CMPI   4,rC          geloest?
E90 ; 7F             BRZ    OVER
987 ; 80             CMPI   8,r7          das war der letzte Versuch?
E85 ; 81             BRZ    LOSE
517 ; 82             ADDI   1,r7          naechster Versuch eine Zeile hoeher, als Kopie
516 ; 83             ADDI   1,r6
C21 ; 84             GOTO   ROW
1BE ; 85 LOSE:       MOVI   B,rE          ACK 11,3: alles eine Zeile nach unten, Zeile 7 wird frei
13D ; 86             MOVI   3,rD
BBA ; 87             CALL   CMD
F0E ; 88 GIVE:       EXRM                 Code nach R8-RB (aufgeben: ohne Schieben; Zeile 7 ist frei oder der offene Versuch) ...
080 ; 89             MOV    r8,r0         ... und in Zeile 7
091 ; 8A             MOV    r9,r1
0A2 ; 8B             MOV    rA,r2
0B3 ; 8C             MOV    rB,r3
176 ; 8D             MOVI   7,r6
107 ; 8E             MOVI   0,r7          Display 0, ROW endet in OVER
C21 ; 8F             GOTO   ROW
F17 ; 90 OVER:       DISP   1,r7          Ende: Versuche bis zum Treffer, 0 = nicht geloest
FFF ; 91             KIN    rF
F02 ; 92             DISOUT
C03 ; 93             GOTO   NEW
8E8 ; 94 TOT:        CMP    rE,r8         Stecker RE gegen den Code
E9D ; 95             BRZ    H8
8E9 ; 96             CMP    rE,r9
E9F ; 97             BRZ    H9
8EA ; 98             CMP    rE,rA
EA1 ; 99             BRZ    HA
8EB ; 9A             CMP    rE,rB
EA3 ; 9B             BRZ    HB
F07 ; 9C             RET
1F8 ; 9D H8:         MOVI   F,r8          vergeben (F ist keine Farbe)
CA4 ; 9E             GOTO   HIT
1F9 ; 9F H9:         MOVI   F,r9
CA4 ; A0             GOTO   HIT
1FA ; A1 HA:         MOVI   F,rA
CA4 ; A2             GOTO   HIT
1FB ; A3 HB:         MOVI   F,rB
51D ; A4 HIT:        ADDI   1,rD
F07 ; A5             RET
938 ; A6 CYC:        CMPI   3,r8          Taste 4-7: rueckwaerts
DAE ; A7             BRC    CB
51A ; A8             ADDI   1,rA          naechste Farbe, nach 6 wieder 1
96A ; A9             CMPI   6,rA
DAC ; AA             BRC    CW
F07 ; AB             RET
11A ; AC CW:         MOVI   1,rA
F07 ; AD             RET
71A ; AE CB:         SUBI   1,rA          vorige Farbe, vor 1 wieder 6
EB1 ; AF             BRZ    CV
F07 ; B0             RET
16A ; B1 CV:         MOVI   6,rA
F07 ; B2             RET
95C ; B3 MOD:        CMPI   5,rC          RC modulo 6, + 1 = Farbe 1-6; R0 + R1 je abgezogene 6
DB7 ; B4             BRC    M6
51C ; B5             ADDI   1,rC
F07 ; B6             RET
76C ; B7 M6:         SUBI   6,rC
410 ; B8             ADD    r1,r0
CB3 ; B9             GOTO   MOD
FDF ; BA CMD:        DIN    rF            Matrixbefehl RE mit RD, RC; an den Ausgaengen liegt 0
31F ; BB             ANDI   1,rF
EBA ; BC             BRZ    CMD
FEE ; BD             DOT    rE            ACK
FED ; BE             DOT    rD            1. Nibble
FEC ; BF             DOT    rC            2. Nibble (bei ACK 3/11 bedeutungslos)
71F ; C0             SUBI   1,rF          danach 0 (erst nach dem Lesen des 2. Nibbles)
FEF ; C1             DOT    rF
F07 ; C2             RET
FDF ; C3 PEG:        DIN    rF            auf REQ warten (an den Ausgaengen liegt 0)
31F ; C4             ANDI   1,rF
EC3 ; C5             BRZ    PEG
FE4 ; C6             DOT    r4            ACK 14
FEA ; C7             DOT    rA            Farbe
FE8 ; C8             DOT    r8            0; das naechste REQ kommt etwa 24 ms nach dem ACK
5F9 ; C9             ADDI   F,r9          ein Pixel nach links
FDF ; CA PW:         DIN    rF
31F ; CB             ANDI   1,rF
ECA ; CC             BRZ    PW
FE5 ; CD             DOT    r5            ACK 4 (R9, R6): Pixel in Farbe RA an
FE9 ; CE             DOT    r9
FE6 ; CF             DOT    r6
FE8 ; D0             DOT    r8            0 bleibt stehen
5FB ; D1 PEGS:       ADDI   F,rB          RB Pixel ab R9 - 1 nach links (Einsprung): Uebertrag, solange RB vorher ab 1
DC3 ; D2             BRC    PEG
F07 ; D3             RET
